# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
DEBUG=True
SECRET_KEY=dev-insecure-change-me-please
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://privguard:privguard@localhost:5432/safehealth
DATABASE_URL_MIGRATE=postgres://privguard:privguard@localhost:5432/safehealth
DB_CONN_MAX_AGE=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Google OAuth (time-permitting add-on; leave blank for JWT-only core)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Server-side secret used to derive deterministic noise seeds
PRIVGUARD_SERVER_SECRET=change-me-too

# Local stack secrets for docker compose. `./run.sh` and `run.bat` copy this to `.env`
# on first run and fill each secret below with a fresh random value.
# `.env` is git-ignored. NEVER commit real secrets, and never put them in this file.
#
# To do it by hand:  cp .env.example .env   then replace each secret's value with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# True only for local demos. With False, the api refuses to start on a placeholder secret.
DEBUG=True

# Database password. It is applied only when the Postgres volume is first created; if you
# already have a volume, run `./run.sh reset` once so it picks up the new password.
POSTGRES_PASSWORD=__GENERATE__

# Signs login tokens (JWT). A known value lets anyone forge a login.
SECRET_KEY=__GENERATE__

# Keys the DP noise. A known value lets an analyst recompute and subtract their own noise.
PRIVGUARD_SERVER_SECRET=__GENERATE__

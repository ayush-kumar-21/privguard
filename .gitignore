# --- Secrets (NEVER commit) ---
.env
backend/.env
frontend/.env
*.pem
*.key
*service-account*.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
env/
.pytest_cache/

# --- Django ---
*.sqlite3
backend/staticfiles/
media/

# --- Node / Vite ---
node_modules/
frontend/dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- Rust engine ---
target/
engine/target/

# --- Generated data ---
# The SafeHealth CSVs are a deterministic function of the seed, so they are
# regenerated (run.bat data) rather than committed. See oracle/dataset.py.
data/

# --- Database dumps / backups ---
*.sql
*.dump

# --- OS / IDE ---
.DS_Store
.idea/
*.iml
.vscode/
.claude/settings.local.json

# local database credentials for one-off setup (never commit)
.env.neon
.env.live

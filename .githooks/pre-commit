#!/bin/sh
# Block direct commits to `main`. Work on `dev` or a feature branch and open a PR.
# Merges (which carry MERGE_HEAD) are allowed, so the owner can still merge PRs locally.
#
# Activate once per clone:  git config core.hooksPath .githooks

branch="$(git symbolic-ref --short HEAD 2>/dev/null)"
git_dir="$(git rev-parse --git-dir 2>/dev/null)"

if [ "$branch" = "main" ] && [ ! -f "$git_dir/MERGE_HEAD" ]; then
  echo "----------------------------------------------------------------------"
  echo " Direct commits to 'main' are blocked."
  echo ""
  echo "   git switch dev                 # or: git switch -c feature/<name>"
  echo "   git commit ...                 # commit your work there"
  echo "   git push origin <branch>       # then open a Pull Request into dev"
  echo ""
  echo " The owner reviews PRs and promotes dev -> main."
  echo "----------------------------------------------------------------------"
  exit 1
fi
exit 0
